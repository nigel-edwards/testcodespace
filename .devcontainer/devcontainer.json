{
    "image":"mcr.microsoft.com/devcontainers/universal:2",
   
    "extensions": [
        "ms-python.python",        // Python extension
        "esbenp.prettier-vscode",  // Prettier extension
        "dbaeumer.vscode-eslint"   // ESLint extension
    ],
    "settings": {
        "editor.formatOnSave": true  // Example of VS Code settings you can add
    },
    // "postCreateCommand": "bash $CODESPACE_VSCODE_FOLDER/.devcontainer/setupmysql.sh > /tmp/nigel.log"
    "postAttachCommand": "docker start $(docker ps -a -q -f status=exited)"
}